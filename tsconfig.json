{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
